{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"root": true,
	"vcs": {
		"enabled": true,
		"useIgnoreFile": true,
		"clientKind": "git"
	},
	"files": {
		"ignoreUnknown": true,
		// components/ui 是 shadcn 生成的，改了下次 `shadcn add` 会覆盖；drizzle/meta 是 drizzle-kit 产物。
		// charts 归 helm lint：模板不是合法 YAML，且 release-version.mjs 按固定格式改写 Chart.yaml；
		// pnpm-workspace.yaml 归 pnpm：它每次改写都用自己的引号风格
		"includes": [
			"**",
			"!src/components/ui",
			"!drizzle/meta",
			"!next-env.d.ts",
			"!charts",
			"!pnpm-workspace.yaml"
		]
	},
	"assist": {
		"enabled": true,
		"actions": {
			"preset": "recommended",
			"source": {
				"preset": "recommended",
				"organizeImports": "on",
				"useSortedAttributes": "on"
			}
		}
	},
	"formatter": {
		"enabled": true
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		},
		"domains": {
			"next": "recommended",
			"react": "recommended"
		}
	}
}
