{
	"name": "ticketodo",
	"version": "0.3.0",
	"description": "企业内部 ticket 与 todo：重要×紧急四象限（P0–P3），authentik 登录，带管理员与审计",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/yupanzi/ticketodo.git"
	},
	"type": "module",
	"private": true,
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build && tsup",
		"typecheck": "next typegen && tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"check": "biome check .",
		"check:write": "biome check --write .",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"migrate": "tsx --env-file-if-exists=.env src/bin/migrate.ts",
		"dueremind": "tsx --env-file-if-exists=.env src/bin/cron/dueremind.ts",
		"release:dry": "semantic-release --dry-run --no-ci",
		"prepare": "husky || true"
	},
	"dependencies": {
		"@better-auth/core": "1.7.15",
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/utilities": "^3.2.2",
		"@orpc/client": "1.16.2",
		"@orpc/contract": "1.16.2",
		"@orpc/json-schema": "1.16.2",
		"@orpc/openapi": "1.16.2",
		"@orpc/openapi-client": "1.16.2",
		"@orpc/server": "1.16.2",
		"@orpc/tanstack-query": "1.16.2",
		"@orpc/zod": "1.16.2",
		"@tanstack/react-query": "^5.105.3",
		"better-auth": "^1.7.15",
		"class-variance-authority": "^0.7.1",
		"cmdk": "^1.1.1",
		"cn": "^0.5.1",
		"date-fns": "^4.4.0",
		"drizzle-orm": "^0.45.4",
		"geist": "^1.9.0",
		"lucide-react": "^1.66.0",
		"next": "16.4.4",
		"next-themes": "^0.4.6",
		"pg": "^8.23.1",
		"pino": "^10.4.0",
		"radix-ui": "^1.8.1",
		"react": "19.3.1",
		"react-day-picker": "^10.0.2",
		"react-dom": "19.3.1",
		"react-markdown": "^10.1.0",
		"remark-gfm": "^4.0.1",
		"server-only": "^0.0.1",
		"shadcn": "^4.23.0",
		"sonner": "^2.0.8",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@semantic-release/changelog": "^7.0.0",
		"@semantic-release/exec": "^7.1.0",
		"@semantic-release/git": "^11.0.1",
		"@tailwindcss/turbopack": "^4",
		"@types/node": "^24.19.2",
		"@types/pg": "^8.23.1",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"conventional-changelog-conventionalcommits": "^9.3.1",
		"drizzle-kit": "^0.31.11",
		"husky": "^9.1.7",
		"semantic-release": "^25.0.9",
		"tailwindcss": "^4",
		"tsup": "^9.0.0",
		"tsx": "^4.23.15",
		"typescript": "^5",
		"vitest": "^5.1.0"
	},
	"packageManager": "pnpm@12.11.2"
}
