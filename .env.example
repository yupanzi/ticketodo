# 复制成 .env 后填写。本文件进版本库，不要写真实密钥。
# web 进程读全部；一次性任务（migrate、due-remind）只读 DATABASE_URL 与 LOG_LEVEL。

# ─────────────────── 必填 ───────────────────

# 密码要 URL 编码；连 RDS 的 sslmode 见 README「部署」
DATABASE_URL="postgresql://ticketodo_user:password@localhost:5432/ticketodo"

# 会话签名与 OAuth token 加密的密钥，至少 32 字符：openssl rand -base64 32
# ⚠️ 换了它全员掉线，已存的 OAuth token 也解不开
BETTER_AUTH_SECRET=""

# authentik 里这个应用的 discovery 地址与 client 凭证。authentik 那边要配的见 README「authentik 配置清单」
AUTHENTIK_DISCOVERY_URL="https://authentik.example.com/application/o/ticketodo/.well-known/openid-configuration"
AUTHENTIK_CLIENT_ID=""
AUTHENTIK_CLIENT_SECRET=""

# ─────────────────── 可选（本地开发全部可留空）───────────────────

# 对外可达的 origin（协议 + 域名 [+ 端口]，不带路径），回调地址是它加 /api/auth/callback/authentik。
# https 意味着前面有代理，会信任 x-forwarded-for 与 x-request-id。
# 留空 = http://localhost:3000，只在非 production 时生效，镜像里必填（部署 values 从 ingress.hostname 派生）。
BETTER_AUTH_URL=""

# 系统里还没有管理员时，这些邮箱的人登录即成为管理员（逗号分隔）。有了管理员之后不再生效
BOOTSTRAP_ADMIN_EMAILS=""

# fatal / error / warn / info / debug / trace / silent，留空即 info。测试默认 silent
LOG_LEVEL=""

# 集成测试专用库（会被测试改写，别指向开发库或生产库）。不设则集成测试跳过
TEST_DATABASE_URL=""
